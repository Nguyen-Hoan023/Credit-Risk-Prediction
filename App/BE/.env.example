# NovaBank CreditRisk — Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to GitHub — it's already in .gitignore

# ── App ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nova_user:your_password@localhost:5432/nova_bank

# ── JWT Authentication ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-256-bit-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── SMTP (Gmail App Password) ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ── OTP ────────────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=5
OTP_MAX_RESEND=3

# ── Default Admin (auto-seeded on first startup) ───────────────────────────────
ADMIN_EMAIL=admin@novabank.com
ADMIN_PASSWORD=YourStrongAdminPassword123!

# ── CORS ───────────────────────────────────────────────────────────────────────
# Dùng khi chạy local (development)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# Dùng khi deploy lên Render (production) — thêm domain Vercel của bạn vào:
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000,http://127.0.0.1:3000
